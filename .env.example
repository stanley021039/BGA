# Copy this file to .env. Keep personal addresses and local paths in .env only.
# Existing operating-system environment variables take precedence.
PORT=3000
HOST=0.0.0.0
# Optional invitation origin. Leave blank to discover the VPN address at runtime.
PUBLIC_URL=
# Relative paths resolve from the project directory; absolute paths are also supported.
HISTORY_DIR=./data/history
# Optional positive-integer history quotas. Defaults shown; blank values are invalid.
HISTORY_MAX_TOTAL_BYTES=536870912
HISTORY_MAX_MATCH_BYTES=67108864
HISTORY_MAX_SESSION_BYTES=2097152
HISTORY_MAX_ARCHIVES=1000
HISTORY_MAX_FILES=2200
HISTORY_RETENTION_DAYS=30
COMMUNITY_DIR=./data/community
DB_FILE=./data/afterhours.sqlite
# Fine-grained GitHub token with Issues read/write access to stanley021039/BGA.
# Keep this value only in the server environment or local .env.
GITHUB_TOKEN=
# Optional values for the Windows firewall setup helper.
RADMIN_INTERFACE=Radmin VPN
VPN_SUBNET=26.0.0.0/8
