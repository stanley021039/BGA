# Copy this file to .env. Keep personal addresses and local paths in .env only.
# Existing operating-system environment variables take precedence.
PORT=3000
HOST=0.0.0.0
# Optional invitation origin. Leave blank to discover the VPN address at runtime.
PUBLIC_URL=
# Relative paths resolve from the project directory; absolute paths are also supported.
HISTORY_DIR=./data/history
COMMUNITY_DIR=./data/community
# Optional values for the Windows firewall setup helper.
RADMIN_INTERFACE=Radmin VPN
VPN_SUBNET=26.0.0.0/8
